# ==============================================================================
# NewsSphere Root Environment Configuration Example
# AI-Powered Personalized and Explainable News Recommendation System
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Edge Functions & Backend Secrets (NEVER expose to React frontend)
# ------------------------------------------------------------------------------
GNEWS_API_KEY=your_gnews_api_key_here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
RECOMMENDATION_SERVICE_URL=http://127.0.0.1:8000
RECOMMENDATION_SERVICE_SECRET=your_shared_secret_token

# ------------------------------------------------------------------------------
# Python FastAPI Recommendation Engine Configuration
# ------------------------------------------------------------------------------
RECOMMENDATION_HOST=0.0.0.0
RECOMMENDATION_PORT=8000
WEIGHT_CATEGORY=0.35
WEIGHT_BEHAVIOR=0.30
WEIGHT_SIMILARITY=0.20
WEIGHT_RECENCY=0.15
DEFAULT_DIVERSITY_WEIGHT=0.25
RECENCY_HALF_LIFE_HOURS=48.0

# Behavioral Signal Weights
WEIGHT_LIKE=3.0
WEIGHT_BOOKMARK=2.5
WEIGHT_READ=1.5
WEIGHT_CLICK=1.0
WEIGHT_SKIP=-2.0
